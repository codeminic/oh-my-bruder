---
import type { ImageMetadata } from 'astro';
import type { StoryEra } from '../lib/story';
import type { Lang } from '../i18n/lang';
import Chapter from './Chapter.astro';

interface Props {
  era: StoryEra<ImageMetadata>;
  lang: Lang;
}

const { era, lang } = Astro.props;
---

<section class="era" data-era={era.id} id={`era-${era.id}`} aria-labelledby={`era-${era.id}-title`}>
  <div class="era-world" aria-hidden="true"><slot name="world" /></div>
  <div class="era-inner">
    <p class="era-label" id={`era-${era.id}-title`}>{era.title}</p>
    {era.chapters.map((c) => <Chapter chapter={c} era={era.id} lang={lang} />)}
    <div class="toy-slot" data-toy={era.toy}><slot name="toy" /></div>
  </div>
</section>
