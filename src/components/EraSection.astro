---
import type { ImageMetadata } from 'astro';
import type { StoryEra } from '../lib/story';
import type { Lang } from '../i18n/lang';
import Chapter from './Chapter.astro';
import EraWorld from './EraWorld.astro';
import GearTrain from '../toys/gears/GearTrain.astro';
import Breadboard from '../toys/breadboard/Breadboard.astro';

interface Props {
  era: StoryEra<ImageMetadata>;
  lang: Lang;
}

const { era, lang } = Astro.props;
---

<section class="era" data-era={era.id} id={`era-${era.id}`} aria-labelledby={`era-${era.id}-title`}>
  <div class="era-world" aria-hidden="true"><EraWorld era={era.id} /></div>
  <div class="era-inner">
    <p class="era-label" id={`era-${era.id}-title`}>{era.title}</p>
    {era.chapters.map((c) => <Chapter chapter={c} era={era.id} lang={lang} />)}
    <div class="toy-slot" data-toy={era.toy}>
      {era.toy === 'gears' && <GearTrain lang={lang} />}
      {era.toy === 'breadboard' && <Breadboard lang={lang} />}
    </div>
  </div>
</section>
