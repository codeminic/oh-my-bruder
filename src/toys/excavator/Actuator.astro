---
// A Technic linear actuator: a dark barrel with a light rod sliding out of it, pinned at both ends.
// The script in Excavator.astro moves it with `placeActuator`, which mirrors the maths here.
import Pin from './Pin.astro';
import type { Segment } from './excavator';

interface Props {
  name: string;
  seg: Segment;
  barrel: number;
}

const { name, seg, barrel } = Astro.props;
const { a, b } = seg;
const len = Math.hypot(b.x - a.x, b.y - a.y);
const L = Math.min(barrel, len - 6);
const e = { x: a.x + ((b.x - a.x) * L) / len, y: a.y + ((b.y - a.y) * L) / len };
const line = (p: { x: number; y: number }, q: { x: number; y: number }) => ({
  x1: p.x.toFixed(1),
  y1: p.y.toFixed(1),
  x2: q.x.toFixed(1),
  y2: q.y.toFixed(1),
});
---

<g class="exc-actuator" data-act={name} data-barrel={barrel}>
  <line data-part="rod" {...line(a, b)} stroke="#a5a9ac" stroke-width="5" stroke-linecap="round"></line>
  <line data-part="rod-hi" {...line(a, b)} stroke="#fff" stroke-width="1.4" stroke-linecap="round" opacity="0.6"></line>
  <line data-part="barrel" {...line(a, e)} stroke="#4f514c" stroke-width="11" stroke-linecap="round"></line>
  <line data-part="barrel-hi" {...line(a, e)} stroke="#8b8e89" stroke-width="3" stroke-linecap="round"></line>
  <circle data-part="collar" cx={e.x.toFixed(1)} cy={e.y.toFixed(1)} r="6.5" fill="#6c6e68" stroke="#363834"></circle>
  <Pin part="pin-a" x={Number(a.x.toFixed(1))} y={Number(a.y.toFixed(1))} color="blue" r={4.4} />
  <Pin part="pin-b" x={Number(b.x.toFixed(1))} y={Number(b.y.toFixed(1))} color="black" r={4} />
</g>
