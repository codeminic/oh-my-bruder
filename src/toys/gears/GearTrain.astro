---
import { t, type Lang } from '../../i18n/lang';
import { GEAR_TEETH } from './gears';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const MODULE = 5; // radius = teeth * module / 2, so neighbours mesh exactly
const radii = GEAR_TEETH.map((n) => (n * MODULE) / 2);
const cy = 110;
const centers = radii.reduce<number[]>((acc, r, i) => {
  acc.push(i === 0 ? 20 + r : acc[i - 1] + radii[i - 1] + r - 2);
  return acc;
}, []);
const width = centers[centers.length - 1] + radii[radii.length - 1] + 20;
const colors = ['#d01012', '#0055bf', '#5b5e62'];

function gearPath(r: number, teeth: number) {
  const pts: string[] = [];
  const tooth = 6;
  for (let i = 0; i < teeth; i++) {
    const a = (2 * Math.PI * i) / teeth;
    const step = (2 * Math.PI) / teeth;
    for (const [da, rr] of [
      [0, r - tooth / 2],
      [step * 0.2, r + tooth / 2],
      [step * 0.5, r + tooth / 2],
      [step * 0.7, r - tooth / 2],
    ] as const) {
      pts.push(`${(Math.cos(a + da) * rr).toFixed(1)},${(Math.sin(a + da) * rr).toFixed(1)}`);
    }
  }
  return `M${pts.join('L')}Z`;
}
---

<div class="toy toy-gears" data-toy-root="gears">
  <p class="toy-label">{t(lang, 'tryIt')} · <span>{t(lang, 'toyGearsHint')}</span></p>
  <svg viewBox={`0 0 ${width} 220`} class="gear-svg" role="group" aria-label={t(lang, 'toyGearsHint')}>
    {
      GEAR_TEETH.map((teeth, i) => (
        <g
          data-gear={i}
          data-cx={centers[i]}
          data-cy={cy}
          transform={`translate(${centers[i]} ${cy}) rotate(0)`}
          {...(i === 0
            ? {
                role: 'slider',
                tabindex: 0,
                'aria-label': t(lang, 'toyGearsHint'),
                'aria-valuemin': 0,
                'aria-valuemax': 360,
                'aria-valuenow': 0,
                class: 'gear gear-driver',
              }
            : { class: 'gear' })}
        >
          <path d={gearPath(radii[i], teeth)} fill={colors[i]} />
          <circle r={radii[i] * 0.55} fill="rgb(0 0 0 / 0.12)" />
          <path
            d={`M${-radii[i] * 0.14},-4h${radii[i] * 0.28}v8h${-radii[i] * 0.28}z M-4,${-radii[i] * 0.14}v${radii[i] * 0.28}h8v${-radii[i] * 0.28}z`}
            fill="#1b1b1b"
          />
          {i === 0 && <circle class="gear-handle" cx={radii[i] * 0.62} cy="0" r="8" fill="#fff" />}
        </g>
      ))
    }
  </svg>
  <p class="toy-done" role="status">{t(lang, 'toyGearsDone')}</p>
</div>

<style>
  .toy {
    margin-top: 2rem;
    padding: 1.25rem;
    border-radius: 0.75rem;
    background: var(--era-card);
    color: var(--era-fg);
  }
  .toy-label {
    margin: 0 0 0.5rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .toy-label span {
    text-transform: none;
    letter-spacing: 0;
    font-weight: 500;
  }
  .gear-svg {
    display: block;
    width: 100%;
    max-width: 460px;
    margin: 0 auto;
    touch-action: none;
  }
  .gear-driver {
    cursor: grab;
  }
  .gear-driver:focus-visible {
    outline: none;
  }
  .gear-driver:focus-visible path:first-child {
    stroke: #4f9dff;
    stroke-width: 4;
  }
  .toy-done {
    min-height: 1.6em;
    margin: 0.5rem 0 0;
    font-weight: 600;
    visibility: hidden;
  }
  :global([data-complete='true']) .toy-done {
    visibility: visible;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { Draggable } from 'gsap/Draggable';
  import { GEAR_TEETH, GearProgress, propagateRotation } from './gears';

  gsap.registerPlugin(Draggable);

  const KEY_STEP = 15;

  for (const root of document.querySelectorAll<HTMLElement>('[data-toy-root="gears"]')) {
    const slot = root.closest<HTMLElement>('[data-toy]') ?? root;
    const gears = [...root.querySelectorAll<SVGGElement>('[data-gear]')];
    const driver = gears[0];
    const svg = root.querySelector('svg')!;
    const progress = new GearProgress();
    let angle = 0;

    const render = () => {
      propagateRotation(angle, GEAR_TEETH).forEach((a, i) => {
        const g = gears[i];
        g.setAttribute('transform', `translate(${g.dataset.cx} ${g.dataset.cy}) rotate(${a.toFixed(2)})`);
      });
      const shown = ((Math.round(angle) % 360) + 360) % 360;
      driver.setAttribute('aria-valuenow', String(shown));
    };

    const turn = (delta: number) => {
      angle += delta;
      progress.add(delta);
      render();
      if (progress.completed && slot.dataset.complete !== 'true') {
        slot.dataset.complete = 'true';
        document.dispatchEvent(new CustomEvent('cv:toy-complete', { detail: { toy: 'gears' } }));
      }
    };

    // Angle of a pointer around the driver's centre, in degrees.
    const pointerAngle = (x: number, y: number) => {
      const pt = svg.createSVGPoint();
      pt.x = Number(driver.dataset.cx);
      pt.y = Number(driver.dataset.cy);
      const c = pt.matrixTransform(svg.getScreenCTM()!);
      return (Math.atan2(y - c.y, x - c.x) * 180) / Math.PI;
    };

    // Draggable drives a proxy so the SVG transform stays under our control.
    const proxy = document.createElement('div');
    let last = 0;
    Draggable.create(proxy, {
      trigger: driver,
      type: 'x,y',
      onPress(this: Draggable) {
        last = pointerAngle(this.pointerX, this.pointerY);
      },
      onDrag(this: Draggable) {
        const now = pointerAngle(this.pointerX, this.pointerY);
        let delta = now - last;
        if (delta > 180) delta -= 360;
        if (delta < -180) delta += 360;
        last = now;
        turn(delta);
      },
    });

    driver.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight' || e.key === 'ArrowUp') turn(KEY_STEP);
      else if (e.key === 'ArrowLeft' || e.key === 'ArrowDown') turn(-KEY_STEP);
      else return;
      e.preventDefault();
    });
  }
</script>
