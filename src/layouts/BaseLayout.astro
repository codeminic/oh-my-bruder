---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import '../styles/eras.css';
import { localizedPath, LANGS, type Lang } from '../i18n/lang';
import { loadProfile } from '../lib/content';
import LangSwitch from '../components/LangSwitch.astro';
import Footer from '../components/Footer.astro';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  /** Path below the locale root, used for hreflang and the language switch. */
  path?: string;
}

const { lang, title, description, path = '' } = Astro.props;
const profile = await loadProfile();
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={localizedPath(l, path)} />)}
    <script is:inline>
      // Mirrors getMotionMode() in src/lib/motion.ts; runs before first paint so CSS can rely on it.
      (function () {
        var d = document.documentElement;
        var reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
        d.dataset.motion = reduced ? 'reduced' : innerWidth <= 767 ? 'simple' : 'full';
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <LangSwitch lang={lang} path={path} />
    <slot />
    <Footer lang={lang} name={profile.name} />
  </body>
</html>
